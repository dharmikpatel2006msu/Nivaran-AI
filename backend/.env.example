# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key (Used for embeddings generation: gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Used for LLM text generation: qwen/qwen3.6-27b)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase Credentials & Database URL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
